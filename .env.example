# Copy this file to .env and fill in real values.
# Never commit .env (it's gitignored) or real secrets.

# ==================================================
# AUTH (better-auth)
# ==================================================
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ==================================================
# DATABASE
# ==================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL="postgresql://postgres:root@localhost:5432/kanlyte_db"

# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If PASSWORD contains special characters (@ # / ? % etc.), URL-encode it
# (e.g. `node -p "encodeURIComponent(process.argv[1])" 'the-password'`) so
# host/user/db parsing can't misfire.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/kanlyte_db"

# ==================================================
# NEXT.JS
# ==================================================
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ==================================================
# EMAIL (Nodemailer via cPanel mailbox)
# ==================================================
# Host: usually "mail.yourdomain.com" or your cPanel server hostname
# (cPanel > Email Accounts > Connect Devices shows the exact value).
#
# Port/security pairs (pick ONE, matching what cPanel shows you):
#   465 -> secure SSL/TLS (implicit)
#   587 -> STARTTLS
# secure is derived automatically from the port in code (true only for 465).
EMAIL_SERVER_HOST="mail.kanlyte.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="info@kanlyte.com"
EMAIL_SERVER_PASSWORD="your-mailbox-password"
EMAIL_FROM="info@kanlyte.com"

# Admin email to receive contact form notifications
ADMIN_EMAIL="info@kanlyte.com"
